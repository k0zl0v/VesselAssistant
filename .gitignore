# --- Логи ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Локальные данные приложения (не должны попадать в репозиторий) ---
*.db
*.db-journal
*.sqlite
*.sqlite-journal
local-data/
backups/
*.backup

# --- Сгенерированные документы (примеры/тесты) ---
generated/
*.xlsx.tmp
*.pdf.tmp
*.docx.tmp

# --- IDE ---
.idea/
.vscode/*
